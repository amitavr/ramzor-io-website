{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ramzor-io-website",
  "main": "_worker.js",
  "compatibility_date": "2026-09-29",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
